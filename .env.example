# ============================================================
# .env.example — Copy this to .env and fill in your values.
# NEVER commit .env to git.
# ============================================================

# --- n8n -------------------------------------------------------
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678
N8N_BASIC_AUTH_ACTIVE=false
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=your_n8n_password_here
N8N_ENCRYPTION_KEY=your_random_32char_key_here

# --- AnythingLLM -----------------------------------------------
# Found in AnythingLLM Settings → API keys
ANYTHINGLLM_BASE_URL=http://localhost:3001
ANYTHINGLLM_API_KEY=your_anythingllm_api_key_here
ANYTHINGLLM_WORKSPACE=resume-generator

# --- ComfyUI ---------------------------------------------------
COMFYUI_API_URL=http://localhost:8188
# Model filename placed in ComfyUI/models/checkpoints/
COMFYUI_MODEL=your_image_model.safetensors

# --- Reactive Resume -------------------------------------------
# Get your API key at: https://rxresu.me → Settings → API Keys
REACTIVE_RESUME_API_URL=https://rxresu.me/api/openapi
REACTIVE_RESUME_API_KEY=your_reactive_resume_api_key_here

# --- Google Drive ----------------------------------------------
# OAuth2 credentials from Google Cloud Console
GDRIVE_CLIENT_ID=your_gdrive_client_id_here.apps.googleusercontent.com
GDRIVE_CLIENT_SECRET=your_gdrive_client_secret_here
# Target folder ID (from the Drive URL)
GDRIVE_FOLDER_ID=your_google_drive_folder_id_here

# --- Timezone --------------------------------------------------
TIMEZONE=Asia/Manila
